# Copy to .env and fill in. No real secret ever belongs in this file (gitleaks
# runs in pre-commit and CI to enforce that). docker-compose.yml supplies
# sane defaults for any value left empty below.

# --- Postgres (client profile: compose-only, never a hosted service) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
POSTGRES_HOST=
POSTGRES_PORT=

# --- App ---
LEDGER_SENSE_ENV=<development|staging|production>
LEDGER_SENSE_SECRET_KEY=changeme

# Origin the web app is served from — the API's CORS allow-list for
# browser-originated calls (see ledger_sense/web/app/baseline/page.tsx, the
# first screen to call the API directly with fetch()). docker-compose.yml
# defaults this to http://localhost:3000 (the demo compose port) if unset.
LEDGER_SENSE_WEB_ORIGIN=

# Origin the browser reaches the API at, baked into the web app's client
# bundle at build time (see ledger_sense/web/Dockerfile). docker-compose.yml
# defaults this to http://localhost:8000 (the demo compose port) if unset.
NEXT_PUBLIC_API_URL=

# Key-encryption key for documents at rest (docs/security.md, "Encryption").
# A Fernet key, generated once per deployment:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up separately from the storage it protects — a backup holding both
# is a backup of plaintext. Unset, the app refuses to store documents.
LEDGER_SENSE_KEK=changeme

# --- Optional model-escalation lane (SYNTHETIC/REDACTED input only) ---
# Leave empty to run fully deterministic, degraded-mode: extraction and
# validation still work end to end with every provider disabled.
MODEL_PROVIDER_API_KEY=

# --- Accounting writeback (sandbox only in v1; draft-only, never posts) ---
ACCOUNTING_SANDBOX_CLIENT_ID=<placeholder>
ACCOUNTING_SANDBOX_CLIENT_SECRET=changeme
