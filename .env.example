# Copy to .env and fill in. No real secret ever belongs in this file (gitleaks
# runs in pre-commit and CI to enforce that). docker-compose.yml supplies
# sane defaults for any value left empty below.

# --- Postgres (client profile: compose-only, never a hosted service) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
POSTGRES_HOST=
POSTGRES_PORT=

# --- App ---
LEDGER_SENSE_ENV=<development|staging|production>
LEDGER_SENSE_SECRET_KEY=changeme

# Origin the web app is served from — the API's CORS allow-list for
# browser-originated calls (see ledger_sense/web/app/baseline/page.tsx, the
# first screen to call the API directly with fetch()). docker-compose.yml
# defaults this to http://localhost:3000 (the demo compose port) if unset.
LEDGER_SENSE_WEB_ORIGIN=

# Origin the browser reaches the API at, baked into the web app's client
# bundle at build time (see ledger_sense/web/Dockerfile). docker-compose.yml
# defaults this to http://localhost:8000 (the demo compose port) if unset.
NEXT_PUBLIC_API_URL=

# Key-encryption key for documents at rest (docs/security.md, "Encryption").
# A Fernet key, generated once per deployment:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up separately from the storage it protects — a backup holding both
# is a backup of plaintext. Unset, the app refuses to store documents.
LEDGER_SENSE_KEK=changeme

# Secret key for the HMAC that fingerprints vendor bank details
# (ledger_sense/domain/vendor.py). Generate a long random value, e.g.
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Account and routing numbers are low-entropy, so the digest is only as strong
# as this key: keep it out of backups of the database. The app refuses to start
# if it is empty.
LEDGER_SENSE_PAYMENT_HMAC_KEY=changeme

# Directory the encrypted blobs live in. docker-compose.yml sets this per
# profile (named volume for client, tmpfs for demo); set it only for a bare
# `uv run` outside compose.
LEDGER_SENSE_BLOB_ROOT=

# --- Optional model-escalation lane (SYNTHETIC/REDACTED input only) ---
# Leave empty to run fully deterministic, degraded-mode: extraction and
# validation still work end to end with every provider disabled.
MODEL_PROVIDER_API_KEY=

# --- Accounting writeback (sandbox only in v1; draft-only, never posts) ---
ACCOUNTING_SANDBOX_CLIENT_ID=<placeholder>
ACCOUNTING_SANDBOX_CLIENT_SECRET=changeme

# Directory the idempotency ledger, audit log, OAuth token store, and CSV/IIF
# exports live in (ledger_sense/writeback/idempotency.py, audit.py, qbo.py,
# export.py). Tokens are encrypted at rest under LEDGER_SENSE_TOKEN_KEY, not
# the document KEK.
LEDGER_SENSE_WRITEBACK_DIR=

# Key the accounting OAuth tokens are encrypted under: its own Fernet key,
# which must differ from LEDGER_SENSE_KEK (one key over both would make the
# loss of either compromise the other). Required once QBO_REALM_ID is set; the
# app refuses to start without it. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEDGER_SENSE_TOKEN_KEY=changeme

# The QuickBooks Online sandbox company (realm) this deployment writes to.
QBO_REALM_ID=

# One tenant-wide default GL account applied to every posted bill line —
# real per-vendor/per-line account mapping is deferred (Phase 6 spec, §2).
LEDGER_SENSE_DEFAULT_ACCOUNT_REF=

# Directory the calibration label/curve store lives in
# (ledger_sense/route/deps.py, backing ledger_sense/route/calibration.py).
# Every accept/edit in the review queue writes here (ledger_sense/api/review.py).
# docker-compose.yml sets this itself for both profiles (a named volume for
# client, tmpfs for demo) and its value wins over this file; set it here only
# when running the API outside compose. Unset, the first accept on a finding
# with a match score fails with a 500 rather than guess a path.
LEDGER_SENSE_CALIBRATION_DIR=
