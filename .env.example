# Copy to .env and fill in. No real secret ever belongs in this file (gitleaks
# runs in pre-commit and CI to enforce that). docker-compose.yml supplies
# sane defaults for any value left empty below.

# --- Postgres (client profile: compose-only, never a hosted service) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
POSTGRES_HOST=
POSTGRES_PORT=

# --- App ---
LEDGER_SENSE_ENV=<development|staging|production>
LEDGER_SENSE_SECRET_KEY=changeme

# --- Optional model-escalation lane (SYNTHETIC/REDACTED input only) ---
# Leave empty to run fully deterministic, degraded-mode: extraction and
# validation still work end to end with every provider disabled.
MODEL_PROVIDER_API_KEY=

# --- Accounting writeback (sandbox only in v1; draft-only, never posts) ---
ACCOUNTING_SANDBOX_CLIENT_ID=<placeholder>
ACCOUNTING_SANDBOX_CLIENT_SECRET=changeme
